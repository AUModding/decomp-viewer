---
import '../styles/index.css';
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Among Us Code Viewer</title>
	</head>
	<body>
		<div class="heading">
			<img src="/AUModders.logo.png" alt="AUModders Logo" width="100" height="100" />
			<h1>Among Us Decompiled Code Viewer</h1>
		</div>
		<div class="content">
			<p>This tool is currently under construction, please be patient!</p>

			<button onclick="window.open('https://aumodding.dev', '_blank')">AU Modding Wiki</button>
			<button class="secondary" onclick="window.open('https://github.com/AUModding/decomp-viewer', '_blank')">GitHub</button>
		</div>
	</body>
</html>
